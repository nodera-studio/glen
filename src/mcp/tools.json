    {
      "name": "glen_inbox",
      "description": "Show replies omp sent back with glen_reply",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "all": {
            "description": "include messages already read",
            "type": "boolean"
          },
          "cwd": {
            "description": "show messages from this project directory",
            "type": "string"
          },
          "peek": {
            "description": "do not mark messages read",
            "type": "boolean"
          },
          "session": {
            "description": "a session id or hex tail",
            "type": "string"
          },
          "timeout": {
            "default": "90s",
            "description": "maximum --wait (at most 24h)",
            "type": "string"
          },
          "wait": {
            "description": "wait for an unread message: exit 0 with it, or exit 10 at --timeout",
            "type": "boolean"
          }
        },
        "type": "object"
