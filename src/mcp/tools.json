{
  "catalog": 1,
  "tools": [
    {
      "name": "glen_ls",
      "description": "List omp sessions (current project; --all for every project)",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "all": {
            "description": "list every project",
            "type": "boolean"
          },
          "cwd": {
            "description": "list this project directory",
            "type": "string"
          },
          "limit": {
            "default": 20,
            "description": "maximum rows (0 = no limit)",
            "minimum": 0,
            "type": "integer"
          },
          "live": {
            "description": "show open sessions only",
            "type": "boolean"
          },
          "since": {
            "description": "updated within this duration",
            "type": "string"
          }
        },
        "type": "object"
      },
      "exec": {
        "command": "ls",
        "args": [
          {
            "name": "all",
            "kind": "flag",
            "long": "all"
          },
          {
            "name": "cwd",
            "kind": "option",
            "long": "cwd"
          },
          {
            "name": "limit",
            "kind": "option",
            "long": "limit"
          },
          {
            "name": "live",
            "kind": "flag",
            "long": "live"
          },
          {
            "name": "since",
            "kind": "option",
            "long": "since"
          }
        ]
      }
    },
    {
      "name": "glen_show",
      "description": "Read a session transcript (active branch)",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "cwd": {
            "description": "resolve the session in this project directory",
            "type": "string"
          },
          "raw": {
            "description": "return omp records unchanged",
            "type": "boolean"
          },
          "session": {
            "description": "session handle or @latest",
            "type": "string"
          },
          "thinking": {
            "description": "include model thinking",
            "type": "boolean"
          },
          "tools": {
            "default": "collapsed",
            "description": "tool-call detail",
            "enum": [
              "collapsed",
              "full",
              "none"
            ],
            "type": "string"
          }
        },
        "required": [
          "session"
        ],
        "type": "object"
      },
      "exec": {
        "command": "show",
        "args": [
          {
            "name": "session",
            "kind": "positional",
            "position": 1
          },
          {
            "name": "cwd",
            "kind": "option",
            "long": "cwd"
          },
          {
            "name": "thinking",
            "kind": "flag",
            "long": "thinking"
          },
          {
            "name": "tools",
            "kind": "option",
            "long": "tools"
          },
          {
            "name": "raw",
            "kind": "flag",
            "long": "raw"
          }
        ]
      }
    },
    {
      "name": "glen_tail",
      "description": "Print the latest transcript items (-f follows)",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "cwd": {
            "description": "resolve the session in this project directory",
            "type": "string"
          },
          "lines": {
            "default": 10,
            "description": "items (0 = only new with -f)",
            "minimum": 0,
            "type": "integer"
          },
          "session": {
            "description": "session handle or @latest",
            "type": "string"
          },
          "thinking": {
            "description": "include model thinking",
            "type": "boolean"
          }
        },
        "required": [
          "session"
        ],
        "type": "object"
      },
      "exec": {
        "command": "tail",
        "args": [
          {
            "name": "session",
            "kind": "positional",
            "position": 1
          },
          {
            "name": "cwd",
            "kind": "option",
            "long": "cwd"
          },
          {
            "name": "lines",
            "kind": "option",
            "long": "lines"
          },
          {
            "name": "thinking",
            "kind": "flag",
            "long": "thinking"
          }
        ]
      }
    },
    {
      "name": "glen_send",
      "description": "Send a message to an omp session and wait for the reply (default 90s) Over MCP: if the host cuts tool calls sooner than 90 s, pass a shorter wait or no_wait, then call glen_wait (the job keeps running). A large result names a spilled file to read. A message of - (stdin) is not available here, and one over about 100 KiB cannot be passed.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "as": {
            "default": "auto",
            "description": "how to deliver the message",
            "enum": [
              "auto",
              "steer",
              "follow-up"
            ],
            "type": "string"
          },
          "cwd": {
            "description": "with @new: the new session’s directory; otherwise: the project to resolve the session in",
            "type": "string"
          },
          "follow_up": {
            "description": "queue a follow-up after the active turn",
            "type": "boolean"
          },
          "message": {
            "description": "message text, or - to read stdin (use -- before a message that starts with -)",
            "type": "string"
          },
          "no_wait": {
            "description": "return the job handle immediately",
            "type": "boolean"
          },
          "session": {
            "description": "session handle, @latest for this project, or @new",
            "type": "string"
          },
          "steer": {
            "description": "steer the active turn (queued jobs send a prompt)",
            "type": "boolean"
          },
          "thinking": {
            "description": "omp's startup reasoning effort for the spawned process: off, minimal, low, medium, high, xhigh, max or auto",
            "type": "string"
          },
          "wait": {
            "default": "90s",
            "description": "maximum foreground wait; the job continues afterwards",
            "type": "string"
          },
          "warm": {
            "description": "keep omp alive for DUR after this job so the next send to the session skips startup (at most 10m; 0 = off)",
            "type": "string"
          }
        },
        "required": [
          "session",
          "message"
        ],
        "type": "object"
      },
      "exec": {
        "command": "send",
        "args": [
          {
            "name": "session",
            "kind": "positional",
            "position": 1
          },
          {
            "name": "message",
            "kind": "positional",
            "position": 2
          },
          {
            "name": "steer",
            "kind": "flag",
            "long": "steer"
          },
          {
            "name": "follow_up",
            "kind": "flag",
            "long": "follow-up"
          },
          {
            "name": "as",
            "kind": "option",
            "long": "as"
          },
          {
            "name": "wait",
            "kind": "option",
            "long": "wait"
          },
          {
            "name": "no_wait",
            "kind": "flag",
            "long": "no-wait"
          },
          {
            "name": "cwd",
            "kind": "option",
            "long": "cwd"
          },
          {
            "name": "thinking",
            "kind": "option",
            "long": "thinking"
          },
          {
            "name": "warm",
            "kind": "option",
            "long": "warm"
          }
        ]
      }
    },
    {
      "name": "glen_wait",
      "description": "Wait for a glen job (default 90s) Over MCP: if the host cuts tool calls sooner than 90 s, pass a shorter timeout and call again (the job keeps running). A large result names a spilled file to read.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "after": {
            "description": "skip replies up to this id (the last id from the previous wake)",
            "type": "string"
          },
          "for": {
            "description": "return when an unseen glen_reply arrives (exit 10, data.woke = reply), or when the job ends",
            "enum": [
              "reply"
            ],
            "type": "string"
          },
          "job": {
            "description": "job handle or full job UUID",
            "type": "string"
          },
          "timeout": {
            "default": "90s",
            "description": "maximum foreground wait; the job continues afterwards",
            "type": "string"
          }
        },
        "required": [
          "job"
        ],
        "type": "object"
      },
      "exec": {
        "command": "wait",
        "args": [
          {
            "name": "job",
            "kind": "positional",
            "position": 1
          },
          {
            "name": "timeout",
            "kind": "option",
            "long": "timeout"
          },
          {
            "name": "for",
            "kind": "option",
            "long": "for"
          },
          {
            "name": "after",
            "kind": "option",
            "long": "after"
          }
        ]
      }
    },
    {
      "name": "glen_jobs",
      "description": "List glen jobs (newest first)",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "active": {
            "description": "show only queued and accepted jobs",
            "type": "boolean"
          },
          "limit": {
            "default": 20,
            "description": "maximum rows (0 = no limit)",
            "minimum": 0,
            "type": "integer"
          },
          "session": {
            "description": "a session id or hex tail",
            "type": "string"
          }
        },
        "type": "object"
      },
      "exec": {
        "command": "jobs",
        "args": [
          {
            "name": "session",
            "kind": "option",
            "long": "session"
          },
          {
            "name": "active",
            "kind": "flag",
            "long": "active"
          },
          {
            "name": "limit",
            "kind": "option",
            "long": "limit"
          }
        ]
      }
    },
