{
  "name": "glen-site",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1 --port 4321",
    "check": "astro check",
    "test:unit": "node --test src/components/terminal/terminal-player.test.mjs scripts/check-budgets.test.mjs src/data/ansi.test.mjs src/data/install.test.mjs scripts/check-links.test.mjs scripts/e2e-server-identity.test.mjs",
    "budgets": "node scripts/check-budgets.mjs",
    "test:e2e": "playwright test",
    "lhci": "lhci autorun",
    "verify": "npm run check && npm run build && npm run test:unit && npm run budgets && npm run links",
    "links": "node scripts/check-links.mjs",
    "deploy": "npm run verify && node scripts/check-links.mjs --online && npx --no wrangler deploy",
    "deploy:dry": "npm run build && npx --no wrangler deploy --dry-run",
    "demo:refresh": "cd .. && GLEN_UPDATE_DEMO=1 cargo test --locked --test site_demo",
    "readme:shot": "node scripts/readme-shot.mjs"
  },
  "dependencies": {
    "@astrojs/react": "7.1.2",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.4.4",
    "motion": "12.43.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "typescript": "6.0.3",
    "wrangler": "4.124.0"
  },
  "private": true
}
