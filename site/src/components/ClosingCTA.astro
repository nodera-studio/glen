---
// Adapted from Morphin infinite-grid-with-framer-motion (CSS ground and inline pointer).
import Actions from './Actions.astro';
import CtaCopy from './islands/CtaCopy';
import {site} from '../data/site';
import {defaultCommand, installView} from '../data/install.mjs';
// The command the Install section opens on: the install script since v0.1.0, Cargo before a release.
const install=defaultCommand(installView(site));
---
<section class="cta-section" aria-labelledby="cta-h"><div class="cta-ground" aria-hidden="true"><div></div><div class="grid-spotlight"></div></div><div class="cta-inner"><h2 id="cta-h">Let your agent into omp.</h2><p>Free and open source. One binary, no server.</p><Actions /><div class="cta-command"><code class="bare">{install.command}</code>{install.copy && <CtaCopy client:visible text={install.command} />}</div></div></section>
<script is:inline>
(() => {
 const ground=document.querySelector('.cta-section');
 if(matchMedia('(hover:hover)').matches){let frame=0;ground.addEventListener('pointermove',e=>{
  if(frame)return;frame=requestAnimationFrame(()=>{const r=ground.getBoundingClientRect();
   ground.style.setProperty('--mx',`${e.clientX-r.left}px`);ground.style.setProperty('--my',`${e.clientY-r.top}px`);frame=0;});
 });}
})();
</script>
