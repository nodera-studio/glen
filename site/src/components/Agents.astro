---
import SectionHead from './SectionHead.astro';
import AgentTabs from './islands/AgentTabs';
import ExitBadge from './ExitBadge.astro';
const codes=[
 {code:'0',state:'success' as const,label:'reply',meaning:'The reply is in the output.'},
 {code:'10',state:'warning' as const,label:'running',meaning:'Still running. Run glen wait <job> later.'},
 {code:'6',state:'warning' as const,label:'needs extension',meaning:'Install the extension, then restart the open omp session.'},
 {code:'7',state:'danger' as const,label:'failed',meaning:'The job failed; details.status says why.'},
 {code:'11',state:'focus' as const,label:'moved',meaning:'omp moved the session. Use the new handle.'},
];
---
<section id="agents" aria-labelledby="agents-h" class="section band"><div class="wrap">
 <SectionHead id="agents-h" eyebrow="03 / Agents" strong="Teach your agent glen." rest="One skill file." lead="Claude Code or Codex. Exit codes tell it what to do next." />
 <div class="agents-layout">
  <div class="tabs-card reveal"><AgentTabs client:visible /></div>
  <div class="exit-list reveal" role="table" aria-label="What each exit code tells your agent">
   <div class="exit-head" role="row"><span role="columnheader">exit</span><span role="columnheader">status</span><span role="columnheader">next step</span></div>
   {codes.map(({code,state,label,meaning})=><div class="exit-row" role="row"><span role="rowheader" class="exit-code tabular">{code}</span><span role="cell"><ExitBadge state={state} label={label}/></span><span role="cell" class="exit-meaning">{meaning}</span></div>)}
  </div>
 </div>
</div></section>
