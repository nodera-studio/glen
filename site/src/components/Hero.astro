---
import Terminal from './terminal/Terminal.astro';
import Actions from './Actions.astro';
---
<section aria-labelledby="hero-h" class="hero hero-glow">
 <div class="wrap">
  <p class="release-chip"><span aria-hidden="true"></span>v0.1.0 · works with omp 18.14.0</p>
  <h1 id="hero-h"><strong class="w-510 text-ink-heading">Let Claude Code and Codex</strong> talk to your omp sessions.</h1>
  <div class="hero-lead-row"><p class="body-lg">glen is a small CLI. It finds omp sessions, reads their transcripts, sends a message into one, and brings the reply back to the agent that asked.</p><Actions /></div>
  <ul class="trust-row">{['macOS and Linux','Single binary','MIT licence'].map(text=><li><svg aria-hidden="true" width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="m3 8 3 3 7-7"/></svg>{text}</li>)}</ul>
 </div>
 <div class="hero-product"><div class="hero-wall" aria-hidden="true"></div><Terminal /></div>
</section>
