<fieldset class="theme-switch flex items-center gap-0.5 rounded-md border border-frame-border p-0.5">
 <legend class="sr-only">Theme</legend>
 {['system','light','dark'].map((pref,i)=><label class="theme-option relative flex size-7 cursor-pointer items-center justify-center rounded-sm" title={pref[0].toUpperCase()+pref.slice(1)}>
  <input class="peer sr-only" type="radio" name="theme" value={pref} aria-label={pref[0].toUpperCase()+pref.slice(1)} />
  <span class="absolute inset-0 rounded-sm peer-checked:bg-frame-raised peer-checked:ring-1 ring-frame-fg-subdued peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-focus"></span>
  <svg class="relative size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
   {i===0 ? <><rect x="3" y="4" width="18" height="13" rx="2"/><path d="M8 21h8m-4-4v4"/></> : i===1 ? <><circle cx="12" cy="12" r="4"/><path d="M12 1v3m0 17v2M1 12h3m17 0h2M4 4l2 2m12 12 2 2M4 20l2-2M18 6l2-2"/></> : <path d="M20.5 14A9 9 0 0 1 10 3.5 9 9 0 1 0 20.5 14Z"/>}
  </svg><span class="sr-only">{pref[0].toUpperCase()+pref.slice(1)}</span>
 </label>)}
</fieldset>
<script is:inline>
(() => {
 const inputs = document.querySelectorAll('.theme-switch input');
 inputs.forEach(input => { input.checked = input.value === document.documentElement.dataset.theme; input.addEventListener('change', () => { if (input.checked) window.glenSetTheme(input.value); }); });
})();
</script>
