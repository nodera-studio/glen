---
import {site} from '../data/site';
const columns=[['Product',[['How it works','#how'],['Install','#install'],['Agents','#agents'],['FAQ','#faq']]],['Project',[['GitHub',site.repoUrl],['Releases',site.releasesUrl],['MIT licence',site.repoUrl+'/blob/main/LICENSE']]],['Credits',[['omp','https://github.com/can1357/oh-my-pi'],['Morphin (MIT)','https://github.com/sikkeep/morphin-registry'],['Nodera Studio','https://github.com/nodera-studio']]]] as const;
---
<footer data-tone="shell"><div class="footer-inner"><div class="footer-grid"><div class="footer-brand"><a class="wordmark focus-ring" href="/">glen</a><p>Let Claude Code and Codex talk to omp.</p></div>{columns.map(([title,links])=><nav aria-label={title}><h2>{title}</h2><ul>{links.map(([label,url])=><li><a class="focus-ring" href={url}>{label}</a></li>)}</ul></nav>)}</div><div class="footer-bottom"><span>Tested with omp 18.14.0</span><span>v0.1.0</span></div></div></footer>
